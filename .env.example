# Copie ce fichier en ".env" et remplis avec tes vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# --- MongoDB local ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=synchronisations
MONGO_SOURCE_COLLECTION=db_france
MONGO_L1_COLLECTION=db_france_syntheses_l1
MONGO_L2_COLLECTION=db_france_syntheses_l2
MONGO_DOMAINES_COLLECTION=db_france_bilans_domaines
MONGO_GLOBAL_COLLECTION=db_france_rapport_mensuel
MONGO_FINALE_COLLECTION=db_france_rapport_mensuel_finale
MONGO_TARGET_COLLECTION=db_france_region_corse

# --- Filtre temporel (laisser vide pour tout traiter, ou ex: 2026-08) ---
MOIS_CIBLE=

# --- Multi-Provider LLM Configuration (auto, google, ou openrouter) ---
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=google,openrouter

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Google AI Studio
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Paramètres de performance & économie tokens ---
BATCH_SIZE=3
MAX_WORKERS=1
PAUSE_SECONDES=1.5
MAX_DOCS_PER_RUN=0
LLM_REQUESTS_PER_MINUTE=14
LLM_MAX_TOKENS_OUTPUT=500
RAW_TEXT_MAX_CHARS=250