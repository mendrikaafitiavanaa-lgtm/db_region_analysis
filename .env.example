# Copie ce fichier en ".env" et remplis avec tes vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# --- MongoDB distant / local ---

MONGO_DB_NAME=France-Corse
# --- 2 Collections Sources Départementales ---
MONGO_SOURCE_COLLECTION_A=Corse-du-Sud
MONGO_SOURCE_COLLECTION_B=Haute-Corse

# 1. Collection Terrain (Stages 1 et 2 : L1 + L2)
MONGO_SYNTHESES_COLLECTION=France_Corse_syntheses_analysis
# 2. Collection Stratégique (Stages 3 et 4 : Bilans domaines + Rapport global)
MONGO_DOMAINES_COLLECTION=France_Corse_domaines_analysis
# 3. Collection Finale Décideurs (Stage 5 : Synthèse mensuelle arbitrage)
MONGO_FINALE_COLLECTION=France_Corse_mensuel_analysis


# --- Filtre temporel et territorial (laisser vide pour tout traiter, ou ex: 2026-08) ---
MOIS_CIBLE=2026-08
REGION=Corse

# --- Multi-Provider LLM Configuration ---
LLM_PROVIDER=auto
# Ordre d'appel en cascade : Gemini (Google) -> OpenRouter -> NVIDIA
LLM_PROVIDER_ORDER=google,openrouter,nvidia
# Cooldown automatique de 24h par clé en cas d'erreur de quota (HTTP 429)
LLM_COOLDOWN_HOURS=24

# 1. Google AI Studio (Gemini Flash)
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-flash-lite-latest"

# 2. OpenRouter Configuration
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# 3. NVIDIA NIM (DeepSeek / Llama / Nemotron)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="deepseek-ai/deepseek-v4.1-flash"

# --- Paramètres de performance et optimisation tokens ---
BATCH_SIZE=8
PAUSE_SECONDES=1.5
MAX_WORKERS=1
MAX_DOCS_PER_RUN=0
RAW_TEXT_MAX_CHARS=250
LLM_MAX_TOKENS_OUTPUT=1500
LLM_TIMEOUT_SECONDES=45
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=14