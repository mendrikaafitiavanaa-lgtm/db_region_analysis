# Copie ce fichier en ".env" et remplis avec tes vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# --- MongoDB local (1 source + 3 collections cibles) ---
#mongo Uri ponte lien serveur
MONGO_URI=
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=France-Corse
MONGO_SOURCE_COLLECTION=Corse-du-Sud

# 1. Collection Terrain (Stages 1 et 2 : L1 + L2)
MONGO_SYNTHESES_COLLECTION=Corse_Sud_syntheses_analysis
# 2. Collection Stratégique (Stages 3 et 4 : Bilans domaines + Rapport global)
MONGO_DOMAINES_COLLECTION=Corse_Sud_domaines_analysis
# 3. Collection Finale Décideurs (Stage 5 : Synthèse mensuelle arbitrage)
MONGO_FINALE_COLLECTION=Corse_Sud_mensuel_analysis

# --- Filtre temporel et territorial (laisser vide pour tout traiter, ou ex: 2026-08) ---
MOIS_CIBLE=2026-08
REGION=region_corse_sud

# --- Multi-Provider LLM Configuration ---
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=google,openrouter

# --- OpenRouter Configuration ---
OPENROUTER_API_KEY=""
#OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# --- Google AI Studio Configuration ---
GOOGLE_AI_API_KEY=""
#GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-flash-lite-latest"

# --- Paramètres de performance et optimisation tokens ---
BATCH_SIZE=8
PAUSE_SECONDES=1.5
MAX_WORKERS=1
MAX_DOCS_PER_RUN=0
RAW_TEXT_MAX_CHARS=250
LLM_MAX_TOKENS_OUTPUT=1500
LLM_TIMEOUT_SECONDES=45
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=14